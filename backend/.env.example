DB_HOST=localhost
DB_PORT=3306
DB_NAME=tropicai
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

SERVER_PORT=8080

# Generate a strong 256-bit base64 secret: openssl rand -base64 32
JWT_SECRET=your-base64-encoded-secret-at-least-256-bits
JWT_EXPIRATION=86400000

# Google OAuth2 — get these from https://console.cloud.google.com
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
OAUTH2_REDIRECT_URI=http://localhost:5173/oauth2/callback
